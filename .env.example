# ==============================================================================
# Solana Arbitrage Scanner (Phase 1: Read-Only, Multi-DEX)
# Configuration Environment Variables
# ==============================================================================

# Solana RPC Endpoints (Default is public mainnet-beta, user can provide custom free-tier RPC e.g. Helius, QuickNode, Triton)
# Note: Public RPC has strict rate limits. For stable WebSocket streaming, a free API key from Helius/QuickNode is recommended.
SOLANA_RPC_HTTP=https://api.mainnet-beta.solana.com
SOLANA_RPC_WS=wss://api.mainnet-beta.solana.com

# Optional Jupiter API Key (Keyless access works at lower rate limits)
# Portal: https://developers.jup.ag/
JUPITER_API_KEY=
JUPITER_API_URL=https://quote-api.jup.ag/v6

# Token Allowlist (Comma-separated symbols; default SOL,USDC only)
SCAN_TOKENS=SOL,USDC

# Simulated Trade Sizes in USDC (Comma-separated exact USD/USDC values)
TRADE_SIZES_USDC=25,50,100,250,500,1000

# Virtual Capital Upper Bound in USDC (Trades larger than this are skipped; NO real wallet funds used)
VIRTUAL_CAPITAL_USDC=1000

# Profitability Hurdles (USDC)
MIN_NET_PROFIT_USDC=0.50
SAFETY_BUFFER_USDC=0.25

# Slippage Tolerance (Basis points; 1 bps = 0.01%)
# Default 10 bps (0.10%) per leg for high-liquidity SOL/USDC pools to protect against adverse selection
SLIPPAGE_BPS_LEG1=10
SLIPPAGE_BPS_LEG2=10

# Freshness & Synchronization Bounds
# Reject quotes older than MAX_QUOTE_AGE_MS or with slot discrepancies greater than MAX_SLOT_GAP
MAX_QUOTE_AGE_MS=2500
MAX_SLOT_GAP=10

# Risk & Quality Filters
MIN_POOL_LIQUIDITY_USD=10000
MAX_PRICE_IMPACT_BPS=200
MAX_EXECUTION_COST_USDC=0.30

# Network Fee Modeling (Phase 1 Estimates - Lamports)
# 5000 lamports = standard 1-signature base fee
NETWORK_FEE_LAMPORTS_PER_SIGNATURE=5000
ESTIMATED_SIGNATURES=1
# Micro-lamport compute priority fee estimate
PRIORITY_FEE_LAMPORTS=10000
# Jito tip estimate (Default 0 for read-only; nonzero allows simulating competitive validator tip costs)
JITO_TIP_LAMPORTS=0
# Execution contingency reserve in USDC
EXECUTION_CONTINGENCY_USDC=0.02

# Operational Polling & Backoff
POLL_INTERVAL_MS=3000
HEALTH_CHECK_INTERVAL_MS=10000
JUPITER_RATE_LIMIT_RPS=1
RPC_RATE_LIMIT_RPS=5

# Storage & Retention
DB_PATH=./data/arbitrage_scanner.db
DB_RETENTION_HOURS=24

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info
