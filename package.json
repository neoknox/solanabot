{
  "name": "solana-arbitrage-bot",
  "version": "1.0.0",
  "description": "Phase 1: Read-Only, Multi-DEX Solana Arbitrage Scanner",
  "main": "dist/cli/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scanner": "tsx src/cli/index.ts",
    "scanner:smoke": "tsx src/cli/smokeTest.ts",
    "report": "tsx src/cli/report.ts",
    "export:csv": "tsx src/cli/exportCsv.ts",
    "build": "tsc"
  },
  "keywords": [
    "solana",
    "arbitrage",
    "dex",
    "scanner",
    "read-only"
