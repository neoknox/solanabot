{
  "name": "solana-arbitrage-bot",
  "version": "1.1.0",
  "description": "Phase 1.1: Quote Accuracy and Scanner Integrity",
  "main": "dist/cli/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scanner": "tsx src/cli/index.ts",
    "scanner:smoke": "tsx src/cli/smokeTest.ts",
    "discover:pools": "tsx src/cli/discoverPools.ts",
    "report": "tsx src/cli/report.ts",
    "export:csv": "tsx src/cli/exportCsv.ts",
    "build": "tsc"
  },
  "keywords": [
    "solana",
    "arbitrage",
    "dex",
    "scanner",
    "read-only"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@orca-so/whirlpools-core": "^3.1.1",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "better-sqlite3": "11.10.0",
    "decimal.js": "10.6.0",
    "dotenv": "16.6.1",
    "ws": "8.22.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
